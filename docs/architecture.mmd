%% title: System architecture
%% React, FastAPI, and the Deep Agents harness run in the frontend and backend containers of
%% docker-compose.yml, and Postgres in the db container. Box labels are names only; the README
%% describes each part.
%% The browser posts a question to FastAPI, and FastAPI streams each step of the loop back as
%% server-sent events. FastAPI runs the harness, which returns every message it produces.
%% The Deep Agents harness holds the agent loop, its tools, and its skills.
%% The tools reach the football database as agent_reader, which has SELECT and nothing else.
%% The backend owns the app database: sessions, results, dashboard items, costs, and conversation memory.
%%{init: {"flowchart": {"rankSpacing": 110, "nodeSpacing": 50}}}%%
flowchart LR
  UI["React app"]:::process
  API["FastAPI"]:::process

  subgraph DA["Deep Agents harness"]
    direction TB
    AG["Agent loop"]:::process
    TL["Tools"]:::process
    SK["Skills"]:::neutral
    AG --- TL
    AG --- SK
  end

  subgraph DB["Postgres"]
    direction TB
    FB[("Football data")]:::durable
    APP[("App data")]:::durable
  end

  OAI["OpenAI"]:::external

  UI -- "Question" --> API
  API -- "Streamed&nbsp;steps" --> UI
  API -- "Question" --> AG
  AG -- "Steps&nbsp;and&nbsp;answer" --> API
  AG <-- "Model&nbsp;requests" --> OAI
  TL -- "Read‑only&nbsp;access" --> FB
  API -- "Read‑write&nbsp;access" --> APP

  classDef process fill:#eaf3fc,stroke:#2367a5,color:#111111,stroke-width:2px;
  classDef neutral fill:#f5f5f5,stroke:#555555,color:#111111,stroke-width:2px;
  classDef durable fill:#edf7ef,stroke:#368447,color:#111111,stroke-width:2px;
  classDef external fill:#fff1df,stroke:#bd6500,color:#111111,stroke-width:2px;
